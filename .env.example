# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (OpenAI-compatible; gsk_… keys) — https://console.groq.com/keys
# Note: gsk_ is Groq, not xAI Grok. Set provider: groq in .agent-org/models.yaml
GROQ_API_KEY=

# Optional overrides
# AGENTIC_ORG_MODEL_BASE_URL=https://api.groq.com/openai/v1
# AGENTIC_ORG_MODEL_API_KEY=

# OpenAI (set provider: openai in .agent-org/models.yaml to use instead)
# OPENAI_API_KEY=

# Optional command-center API token. When set, mutating /api/* requests
# (POST/PUT/PATCH/DELETE) require Authorization: Bearer <token> or
# X-Agentic-Org-Token. GET/SSE remain open for the local dashboard.
# AGENTIC_ORG_API_TOKEN=
